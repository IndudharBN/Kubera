# Kubera daemon env — copy to daemon/.env.daemon and fill in.
# daemon/.env.daemon is gitignored (never commit live creds).

# ── Zerodha Kite Connect ──────────────────────────────────────────────────────
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret
# Daily token: generate via request_token → generateSession (TOTP-automate pre-open).
KITE_ACCESS_TOKEN=

# ── India trading config ──────────────────────────────────────────────────────
KITE_PRODUCT=MIS            # MIS (intraday) | CNC (delivery) | NRML
CAPITAL_CAP_INR=100000      # hard ₹ capital cap
DEPLOY_CAP_PCT=0.70         # max combined open notional as fraction of capital

# Safety: execution is OFF unless explicitly 'true' (shadow-first).
DAEMON_AUTO_EXECUTE=false
DAEMON_PORT=3001
